# Local OpenSearch (Docker Compose defaults; use non-production credentials only)
OPENSEARCH_HOST=http://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_INDEX=vector-db-comparison-lab

# Local PostgreSQL + pgvector (Docker Compose defaults; use non-production credentials only)
PGVECTOR_DSN=postgresql://postgres:postgres@localhost:5432/vector_lab
PGVECTOR_TABLE=documents

# Local Chroma persistence
CHROMA_PERSIST_DIRECTORY=./.chroma
CHROMA_COLLECTION=vector_db_comparison_lab

# Pinecone: create a cosine index with VECTOR_DIMENSION first
PINECONE_API_KEY=replace-with-api-key
PINECONE_INDEX=demo-index
PINECONE_NAMESPACE=vector-lab

# Shared benchmark parameters. Vectors in the starter lab are synthetic, not embeddings.
VECTOR_DIMENSION=8
